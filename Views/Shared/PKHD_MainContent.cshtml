@model IEnumerable<Sach>

<div class="section-head">
    <h3>@ViewData["TieuDe"]</h3>
    <a asp-controller="PKHD_Sach" asp-action="Create">+ Thêm sách mới</a>
</div>
<div class="grid">
    @foreach (var s in Model)
    {
        <div class="book-card">
            <a href="#"><img src="@Url.Content("~/images/" + s.Anh)" alt="@s.TenSach" /></a>
            <h2>@s.TenSach</h2>
            <div class="book-foot">
                <span class="price">@s.Gia</span>
                <button class="btn-buy">Thêm vào giỏ</button>
            </div>
        </div>
    }
</div>
@if (!Model.Any())
{
    <p>Không có sách nào.</p>
}